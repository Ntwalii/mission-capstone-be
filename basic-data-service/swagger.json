{
  "swagger": "2.0",
  "info": { "version": "1.0.0", "title": "Backend Service 1 API" },
  "schemes": ["http"],
  "host": "localhost:4001",
  "basePath": "/v1",
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Bearer <token>"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/items": {
      "get": {
        "summary": "List items",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "summary": "Create item",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["name"]
            }
          }
        ],
        "responses": { "201": { "description": "created" } }
      }
    },
    "/items/{id}": {
      "patch": {
        "summary": "Update item",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object" } }
        ],
        "responses": { "200": { "description": "updated" } }
      },
      "delete": {
        "summary": "Delete item",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" }
        ],
        "responses": { "204": { "description": "deleted" } }
      }
    },
    "/items/stats": {
      "get": {
        "summary": "Aggregated trade stats (core.trade_data; gross import/export only)",
        "description": "Returns totals for the requested year (and quarter if provided), plus Deepdata (per-quarter amounts when quarter omitted), countryData, and regionalData (by continent).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32",
            "description": "Year, e.g. 2022"
          },
          {
            "name": "quarter",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "enum": [1, 2, 3, 4],
            "description": "Quarter 1..4. If omitted, aggregates full year and returns all quarters in Deepdata."
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregated stats",
            "schema": { "$ref": "#/definitions/ItemsStatsResponse" },
            "examples": {
              "application/json": {
                "tradeValue": 123456789.12,
                "tradeBalance": -456789.0,
                "exports": 60000000.0,
                "imports": 60456789.12,
                "Deepdata": { "Q1": 30000000.0, "Q2": 31000000.0, "Q3": 32000000.0, "Q4": 35000000.0 },
                "countryData": {
                  "Kenya": { "export": 23000000.0, "import": 72000000.0, "totalTradeValue": 95000000.0 }
                },
                "regionalData": {
                  "Africa": 150000000.0,
                  "Europe": 90000000.0
                }
              }
            }
          },
          "400": { "description": "Invalid parameters" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/items/partners": {
      "get": {
        "summary": "List partner countries",
        "description": "Returns core.trade_partners (optionally only those that have data for the given year/quarter).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "withData",
            "in": "query",
            "required": false,
            "type": "boolean",
            "description": "If true, only partners that have core.trade_data for the given year[/quarter] are returned."
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "description": "Required when withData=true, e.g., 2022"
          },
          {
            "name": "quarter",
            "in": "query",
            "required": false,
            "type": "integer",
            "enum": [1, 2, 3, 4],
            "description": "Optional when withData=true (filters to a specific quarter)"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of partners",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Partner" }
            }
          },
          "400": { "description": "Invalid parameters" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/items/stats/continents": {
      "get": {
        "summary": "Trade value by continent (core.trade_data; gross import + export)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32",
            "description": "Year, e.g., 2022"
          },
          {
            "name": "quarter",
            "in": "query",
            "required": false,
            "type": "integer",
            "enum": [1, 2, 3, 4],
            "description": "Optional quarter filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of continent sums",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/ContinentSum" }
            }
          },
          "400": { "description": "Invalid parameters" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/items/stats/top-exports": {
      "get": {
        "summary": "Top export products for a year",
        "description": "Sums Gross Exports (trade_flow_code=2) by commodity for the given year and returns the top N with YoY growth vs. previous year.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "type": "integer",
            "format": "int32",
            "description": "Year, e.g. 2022"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 5,
            "description": "How many products to return (1..50)"
          }
        ],
        "responses": {
          "200": {
            "description": "Top export products",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rank": { "type": "integer" },
                  "commodityId": { "type": "integer" },
                  "productName": { "type": "string" },
                  "category": { "type": "string" },
                  "value": { "type": "number", "format": "double" },
                  "valueFormatted": { "type": "string" },
                  "growthPct": { "type": "number", "format": "double", "nullable": true }
                },
                "required": ["rank", "commodityId", "productName", "value"]
              }
            },
            "examples": {
              "application/json": [
                { "rank": 1, "commodityId": 42, "productName": "Coffee", "category": "Agricultural", "value": 280000000, "valueFormatted": "$280M", "growthPct": 18.0 },
                { "rank": 2, "commodityId": 19, "productName": "Tea", "category": "Agricultural", "value": 165000000, "valueFormatted": "$165M", "growthPct": 8.0 }
              ]
            }
          },
          "400": { "description": "Invalid parameters" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/items/commodities": {
      "get": {
        "summary": "List commodities (searchable)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "q", "in": "query", "required": false, "type": "string", "description": "Search by name or code" },
          { "name": "limit", "in": "query", "required": false, "type": "integer", "default": 20, "maximum": 100 },
          { "name": "offset", "in": "query", "required": false, "type": "integer", "default": 0 }
        ],
        "responses": {
          "200": {
            "description": "Array of commodities",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Commodity" } }
          }
        }
      }
    },
    "/items/market/opportunities": {
      "get": {
        "summary": "Market opportunities (by partner). If commodity filter omitted, returns top markets and their top commodity.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "year", "in": "query", "required": true, "type": "integer", "format": "int32" },
          { "name": "commodityId", "in": "query", "required": false, "type": "integer", "format": "int32" },
          { "name": "q", "in": "query", "required": false, "type": "string", "description": "Commodity text search; ignored if commodityId present" },
          { "name": "limit", "in": "query", "required": false, "type": "integer", "default": 10, "maximum": 50 }
        ],
        "responses": {
          "200": {
            "description": "Ranked markets",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/MarketOpportunity" }
            }
          },
          "400": { "description": "Invalid parameters" }
        }
      }
    },
    "/items/whatif/simulate": {
      "post": {
        "summary": "Simulate an export uplift scenario and compare to the current year baseline",
        "description": "Applies an export percentage change to a selected slice (optionally filtered by partner ISO3 and/or commodityId) and returns current vs. scenario totals plus deltas and a chart-ready series.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["year", "exportChangePct"],
              "properties": {
                "year": {
                  "type": "integer",
                  "format": "int32",
                  "example": 2024,
                  "description": "Target year for the simulation."
                },
                "exportChangePct": {
                  "type": "number",
                  "format": "double",
                  "example": 10,
                  "description": "Percent change to apply to the affected export slice (can be negative)."
                },
                "partnerIso3": {
                  "type": "string",
                  "example": "USA",
                  "description": "Optional 3-letter ISO3 code to restrict the affected slice to a single partner."
                },
                "commodityId": {
                  "type": "integer",
                  "format": "int32",
                  "example": 741,
                  "description": "Optional commodity id to restrict the affected slice to a single commodity (within the partner if provided)."
                },
                "name": {
                  "type": "string",
                  "example": "2025 Growth Projection",
                  "description": "Optional scenario label (not used by backend calculations)."
                }
              }
            }
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Simulation computed successfully",
            "schema": {
              "type": "object",
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "year": { "type": "integer", "format": "int32" },
                    "partnerIso3": { "type": "string" },
                    "commodityId": { "type": "integer", "format": "int32" },
                    "exportChangePct": { "type": "number", "format": "double" }
                  }
                },
                "current": { "$ref": "#/definitions/TradeTotals" },
                "scenario": { "$ref": "#/definitions/TradeTotals" },
                "deltas": {
                  "type": "object",
                  "properties": {
                    "exportsDelta": { "type": "number", "format": "double" },
                    "importsDelta": { "type": "number", "format": "double" },
                    "balanceDelta": { "type": "number", "format": "double" }
                  }
                },
                "chart": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/ChartPoint" },
                  "example": [
                    { "name": "Current", "export": 4000, "import": 2400 },
                    { "name": "Scenario", "export": 4500, "import": 2400 }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": { "type": "object", "properties": { "error": { "type": "string" } } }
          },
          "401": { "description": "Unauthorized" }
        },
        "tags": ["WhatIf"]
      }
    }
  },
  "definitions": {
    "ItemsStatsResponse": {
      "type": "object",
      "properties": {
        "tradeValue": { "type": "number", "format": "double" },
        "tradeBalance": { "type": "number", "format": "double" },
        "exports": { "type": "number", "format": "double" },
        "imports": { "type": "number", "format": "double" },
        "Deepdata": {
          "type": "object",
          "description": "Quarter to amount map. If quarter is provided, contains only that quarter.",
          "additionalProperties": { "type": "number", "format": "double" }
        },
        "countryData": {
          "type": "object",
          "description": "Country name -> metrics",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "export": { "type": "number", "format": "double" },
              "import": { "type": "number", "format": "double" },
              "totalTradeValue": { "type": "number", "format": "double" }
            },
            "required": ["export", "import", "totalTradeValue"]
          }
        },
        "regionalData": {
          "type": "object",
          "description": "Continent -> total trade value",
          "additionalProperties": { "type": "number", "format": "double" }
        }
      },
      "required": ["tradeValue", "tradeBalance", "exports", "imports", "Deepdata", "countryData", "regionalData"]
    },
    "Partner": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "format": "int32" },
        "name": { "type": "string" },
        "iso3": { "type": "string" },
        "continent": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ContinentSum": {
      "type": "object",
      "properties": {
        "continent": { "type": "string" },
        "tradeValue": { "type": "number", "format": "double" }
      },
      "required": ["continent", "tradeValue"]
    },
    "Commodity": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "format": "int32" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "MarketOpportunity": {
      "type": "object",
      "properties": {
        "partnerId": { "type": "integer", "format": "int32" },
        "partnerName": { "type": "string" },
        "iso3": { "type": "string" },
        "marketSize": { "type": "number", "format": "double" },
        "averagePricePerKg": { "type": "number", "format": "double", "nullable": true },
        "growthPct": { "type": "number", "format": "double", "nullable": true },
        "tariffRate": { "type": "number", "format": "double", "nullable": true },
        "badge": { "type": "string" },
        "topCommodity": {
          "type": "object",
          "nullable": true,
          "properties": {
            "commodityId": { "type": "integer", "format": "int32" },
            "commodityName": { "type": "string" },
            "commodityCode": { "type": "string" },
            "value": { "type": "number", "format": "double" }
          }
        }
      },
      "required": ["partnerId", "partnerName", "iso3", "marketSize", "badge"]
    },
    "TradeTotals": {
      "type": "object",
      "properties": {
        "exports": { "type": "number", "format": "double" },
        "imports": { "type": "number", "format": "double" },
        "balance": { "type": "number", "format": "double" }
      },
      "required": ["exports", "imports", "balance"]
    },
    "ChartPoint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "export": { "type": "number", "format": "double" },
        "import": { "type": "number", "format": "double" }
      },
      "required": ["name", "export", "import"]
    }
  }
}
